# ==========================================
# WMS Backend Environment Variables (Template)
# ==========================================

# 1. Database & Redis (팀원 통합 트랙 전용 포트 적용됨)
DATABASE_URL=postgresql://admin:password@localhost:5433/wms_db
REDIS_URL=redis://localhost:6380/0

# 2. JWT 및 보안 설정
JWT_SECRET_KEY=local-development-secret-key-change-this-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SSE_TICKET_EXPIRE_SECONDS=300

# 3. 외부 API 키
OPENAI_API_KEY=
ALADIN_TTB_KEY=

# 4. 초기 마스터 관리자 계정 (서버 기동 시 자동 생성)
INITIAL_MASTER_EMPLOYEE_ID=WM2607001
INITIAL_MASTER_NAME=조장님
INITIAL_MASTER_EMAIL=master@wms.example.com
INITIAL_MASTER_PASSWORD=admin123!

# 5. 네트워크 라벨 프린터 설정
LABEL_PRINTER_ENABLED=false
LABEL_PRINTER_HOST=
LABEL_PRINTER_PORT=9100
LABEL_PRINTER_TIMEOUT_SECONDS=5.0
LABEL_PRINTER_ENCODING=utf-8

# 6. AWS S3 및 CloudFront 설정 (이미지 업로드 및 서빙용)
OSS_REGION=ap-northeast-2
OSS_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
OSS_BUCKET_NAME=wms-book-photos-prod
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
CLOUDFRONT_DOMAIN=

# 7. 기타 설정
WMS_REQUEST_TIMEOUT_SECONDS=10.0
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8002
